{
  "name": "arbiter-dashboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "20.19.x"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "vue-tsc": "nuxt prepare && vue-tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.7.0",
    "@vueform/slider": "^2.1.10",
    "@vuepic/vue-datepicker": "^14.0.0",
    "lucide-vue-next": "^0.477.0",
    "nuxt": "^3.15.0",
    "nuxt-auth-utils": "^0.5.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.12.0",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/coverage-v8": "^2.1.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9",
    "jsdom": "25.0.1",
    "lint-staged": "^15.5.2",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.6"
  },
  "lint-staged": {
    "*.{ts,vue,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css}": [
      "prettier --write"
    ]
  }
}
