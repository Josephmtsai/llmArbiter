# Arbiter Dashboard — environment variables
# Copy to .env and fill in values (never commit .env)

# Server-side only — UI login password (maps to runtimeConfig.authPassword)
# Required, minimum 32 characters, and must not be left at the placeholder
# below - the server asserts both at startup and refuses to boot otherwise
# (server/plugins/assert-config.ts). Generate with: openssl rand -hex 32
NUXT_AUTH_PASSWORD=replace-me-with-openssl-rand-hex-32-output

# nuxt-auth-utils session encryption key (generate with: openssl rand -hex 32)
NUXT_SESSION_PASSWORD=replace-me-with-openssl-rand-hex-32-output

# External Arbiter API — server-side only, never exposed to browser.
# Browser calls /api/arbiter/*; Nuxt server forwards X-API-Key.
NUXT_API_BASE_URL=https://artbiter-production.up.railway.app
NUXT_API_KEY=your_api_key_here

# Railway/Nitro server port
PORT=8080
