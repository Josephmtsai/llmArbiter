# Arbiter Dashboard — environment variables
# Copy to .env and fill in values (never commit .env)

# Server-side only — UI login password (maps to runtimeConfig.authPassword)
# Required, minimum 8 characters, and must not be left at the placeholder
# below - the server asserts both at startup and refuses to boot otherwise
# (server/plugins/assert-config.ts).
# Use 8-15 RANDOM characters. Do not use a dictionary word: the login endpoint
# is rate limited to 5 attempts per address per minute and 30 per minute across
# all sources, which stops brute force but does not stop a lucky guess at a
# common password.
# Generate one with: openssl rand -base64 12 | cut -c1-12
NUXT_AUTH_PASSWORD=replace-me-with-openssl-rand-hex-32-output

# nuxt-auth-utils session encryption key. This one is NOT the login password and
# has its own, higher floor: it must be AT LEAST 32 characters, because
# nuxt-auth-utils uses it as the iron-webcrypto seal key and requires 32 itself.
# Do not lower it to the 8 above - the two floors are deliberately different.
# Generate with: openssl rand -hex 32
NUXT_SESSION_PASSWORD=replace-me-with-openssl-rand-hex-32-output

# External Arbiter API — server-side only, never exposed to browser.
# Browser calls /api/arbiter/*; Nuxt server forwards X-API-Key.
# Both are REQUIRED and asserted at startup: the key must be non-empty and the
# base URL an absolute http(s) URL. Otherwise the server would boot, pass the
# Railway healthcheck, and fail every dashboard request upstream. Only the
# configuration is checked - the upstream is never contacted at boot.
NUXT_API_BASE_URL=https://artbiter-production.up.railway.app
NUXT_API_KEY=your_api_key_here

# Railway/Nitro server port
PORT=8080
